# Copy this file to .env and fill every value before starting the stack.
# Do not commit the real .env file.

PLANNER_POSTGRES_USER=planner
PLANNER_POSTGRES_PASSWORD=
PLANNER_POSTGRES_DB=planner

KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=
KEYCLOAK_POSTGRES_DB=keycloak

# Technical Keycloak bootstrap account used only by the API to create app users.
# This is not the first application administrator.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=

KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_API_CLIENT_SECRET=
NEXTAUTH_SECRET=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
